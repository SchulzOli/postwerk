# Password for the bundled Postgres container (docker compose). Set before the first start.
POSTGRES_PASSWORD=postwerk

# Postgres connection (docker compose up -d postgres starts one on localhost:5432)
DATABASE_URL=postgres://postwerk:postwerk@localhost:5432/postwerk

# Encrypts stored social account tokens. Generate with: openssl rand -base64 32
# Never change it after accounts are connected, or they must all be reconnected.
ENCRYPTION_KEY=

# Public URL of the web app (used for OAuth callbacks), without trailing slash
APP_URL=http://localhost:3000

# Shows a fake "Sandbox" network for trying things out without real accounts
ENABLE_SANDBOX=true

# How often the worker looks for due posts
WORKER_POLL_INTERVAL_MS=10000

# Only for running integration tests (npm test)
TEST_DATABASE_URL=postgres://postwerk:postwerk@localhost:5432/postwerk_test
