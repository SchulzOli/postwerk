# Password for the bundled Postgres container (docker compose). Set before the first start.
POSTGRES_PASSWORD=postwerk

# Postgres connection (docker compose up -d postgres starts one on localhost:5432)
DATABASE_URL=postgres://postwerk:postwerk@localhost:5432/postwerk

# Encrypts stored social account tokens. Generate with: openssl rand -base64 32
# Never change it after accounts are connected, or they must all be reconnected.
ENCRYPTION_KEY=

# Public URL of the web app (used for OAuth callbacks), without trailing slash
APP_URL=http://localhost:3000

# Shows a fake "Sandbox" network for trying things out without real accounts
ENABLE_SANDBOX=true

# How often the worker looks for due posts
WORKER_POLL_INTERVAL_MS=10000

# Uploaded images and videos. "local" keeps them in MEDIA_DIR (shared by web and
# worker; relative paths are resolved from apps/web and apps/worker in development)
# and serves them at APP_URL/media/…; social networks fetch them from there, so
# APP_URL must be public for Instagram, Facebook, Threads, Pinterest and TikTok.
MEDIA_STORAGE=local
MEDIA_DIR=../../data/media
# Largest video upload in MB (images: 20 MB)
MEDIA_MAX_VIDEO_MB=512
# For MEDIA_STORAGE=s3 (AWS, MinIO, Cloudflare R2, Backblaze, Hetzner…). Files are
# private and shared with presigned links unless S3_PUBLIC_URL (public bucket/CDN) is set.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=

# Email (password resets, invites, email confirmation, failed-post alerts).
# smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465. Without it,
# emails are printed to the server log instead of being sent.
SMTP_URL=
MAIL_FROM=Postwerk <postwerk@example.com>

# Only for running integration tests (npm test)
TEST_DATABASE_URL=postgres://postwerk:postwerk@localhost:5432/postwerk_test

# --- Operator apps -----------------------------------------------------------
# Register one developer app per network; every user of this server can then
# connect with a click. Leave empty to hide the network. Callback URL to enter
# in each developer console: ${APP_URL}/api/connect/<network>/callback
# (network ids: facebook, instagram, threads, linkedin, linkedin_page, x,
#  tiktok, youtube, google_business, pinterest, reddit). See docs/PLATFORMS.md.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# LinkedIn profiles and pages
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# YouTube and Google Business Profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Bridge (Zernio) -----------------------------------------------------------
# Without developer apps, networks can connect through Zernio (zernio.com), an
# API that already passed every network's review. See docs/BRIDGE.md.
ZERNIO_API_KEY=
# Optional: only these networks use Zernio (even if a developer app exists),
# e.g. instagram,tiktok. Empty: every network without a developer app.
ZERNIO_NETWORKS=
# Optional: your monthly price per account for cost estimates, e.g. 6 or 5.50 EUR
ZERNIO_ACCOUNT_PRICE=
