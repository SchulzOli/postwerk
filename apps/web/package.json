{
  "name": "@postwerk/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && cp -r .next/static .next/standalone/apps/web/.next/static",
    "start": "node .next/standalone/apps/web/server.js",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@postwerk/core": "*",
    "@postwerk/db": "*",
    "@postwerk/providers": "*",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
