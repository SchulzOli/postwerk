{
  "name": "marketing-as-a-service",
  "private": true,
  "description": "Self-hosted social media scheduler: write once, publish everywhere.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchulzOli/MarketingAsAService.git"
  },
  "homepage": "https://github.com/SchulzOli/MarketingAsAService#readme",
  "bugs": {
    "url": "https://github.com/SchulzOli/MarketingAsAService/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@maas/web & npm run dev --workspace=@maas/worker; wait",
    "dev:web": "npm run dev --workspace=@maas/web",
    "dev:worker": "npm run dev --workspace=@maas/worker",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:generate": "npm run generate --workspace=@maas/db",
    "db:migrate": "npm run migrate --workspace=@maas/db",
    "services:up": "docker compose up -d postgres",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
